{
    "realm": "dms",
    "enabled": true,
    "roles": {
        "realm": [
            {
                "name": "DMS_ADMIN",
                "description": "Administrator — can delete documents"
            },
            {
                "name": "DMS_USER",
                "description": "User — can create, list, and get documents"
            },
            {
                "name": "DMS_SERVICE",
                "description": "Service Account Role"
            }
        ]
    },
    "clients": [
        {
            "clientId": "dms-client",
            "enabled": true,
            "publicClient": true,
            "secret": "dms-secret",
            "clientAuthenticatorType": "client-secret",
            "directAccessGrantsEnabled": true,
            "redirectUris": [
                "*"
            ]
        },
        {
            "clientId": "dms-service",
            "enabled": true,
            "publicClient": false,
            "secret": "your-service-secret-key",
            "clientAuthenticatorType": "client-secret",
            "serviceAccountsEnabled": true,
            "directAccessGrantsEnabled": true,
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "protocol": "openid-connect",
            "protocolMappers": [
                {
                    "name": "tenant_id",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-attribute-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "tenant_id",
                        "claim.name": "tenant_id",
                        "jsonType.label": "String",
                        "id.token.claim": "true",
                        "access.token.claim": "true",
                        "userinfo.token.claim": "true"
                    }
                }
            ]
        }
    ],
    "users": [
        {
            "username": "dms_admin",
            "firstName": "DMS",
            "lastName": "Admin",
            "email": "dms_admin@example.com",
            "enabled": true,
            "emailVerified": true,
            "attributes": {
                "tenant_id": ["default"]
            },
            "realmRoles": [
                "DMS_ADMIN",
                "DMS_USER"
            ],
            "credentials": [
                {
                    "type": "password",
                    "value": "dms_admin_password",
                    "temporary": false
                }
            ]
        },
        {
            "username": "service-account-dms-service",
            "enabled": true,
            "serviceAccountClientId": "dms-service",
            "realmRoles": [
                "DMS_SERVICE"
            ]
        }
    ]
}
